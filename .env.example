# Copie para .env e preencha. O .env NUNCA vai para o git.
ENVIRONMENT=local
SQL_ECHO=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=troque-esta-senha

# Gere a sua com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-por-uma-gerada-com-secrets-token-urlsafe-64

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cotacoes -----------------------------------------------------------------
# Opcional. Sem token, o plano gratuito da brapi responde poucos tickers.
# Pegue o seu em https://brapi.dev (15.000 requisicoes/mes de graca).
BRAPI_TOKEN=
# Idade maxima da cotacao em cache (segundos). 900 = 15 min.
QUOTE_TTL_SECONDS=900
HTTP_TIMEOUT_SECONDS=5.0

# Limites de requisicao por IP
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_REFRESH=30/minute

# Chave do cron de snapshots. Vazio = rota de servico desligada.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_API_KEY=

# Taxa livre de risco anual (CDI/Selic) para o indice de Sharpe.
RISK_FREE_RATE=0.10

# Vazio em dev (frontend servido pela propria API). Em producao: lista explicita.
CORS_ORIGINS=

# --- Observabilidade ---------------------------------------------------------
# JSON em producao (para o agregador), texto legivel no desenvolvimento.
LOG_LEVEL=INFO
LOG_JSON=false
